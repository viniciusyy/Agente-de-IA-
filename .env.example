# ============================================================
# MODELO DE LINGUAGEM
# ============================================================

LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=

# Preço em dólares por 1 milhão de tokens.
# O valor 0.0 permite executar sem calcular custo até que os
# preços do modelo escolhido sejam preenchidos.
LLM_INPUT_PRICE_PER_MILLION=0.0
LLM_OUTPUT_PRICE_PER_MILLION=0.0
LLM_MAX_OUTPUT_TOKENS=700


# ============================================================
# BANCO OPERACIONAL MYSQL
# ============================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=pasteis_miyata
DB_USER=
DB_PASSWORD=


# ============================================================
# ORÇAMENTO DO AGENTE
# ============================================================

AGENT_MAX_STEPS=10
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_TOKENS=12000
AGENT_MAX_TIME_SECONDS=90
AGENT_MAX_COST_USD=0.15

GRAPH_RECURSION_LIMIT=24
LOOP_REPEAT_LIMIT=3
CONVERSATION_MAX_TURNS=6


# ============================================================
# RAG, MEMÓRIA E HUMAN-IN-THE-LOOP
# ============================================================

RAG_MAX_RESULTS=3
RAG_MIN_SCORE=0.001

MEMORY_EPISODE_HALF_LIFE_DAYS=90
APPROVAL_TIMEOUT_HOURS=24

CHECKPOINT_DATABASE=dados/checkpoints.sqlite3
MEMORY_DATABASE=dados/memoria.sqlite3
CORPUS_DIRECTORY=dados/corpus
LOG_DIRECTORY=logs


# ============================================================
# IDENTIFICAÇÃO DO USUÁRIO E DA CONVERSA
# ============================================================

AGENT_USER_ID=proprietario
AGENT_THREAD_ID=proprietario-principal